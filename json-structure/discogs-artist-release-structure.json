{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/discogs/refs/heads/main/json-structure/discogs-artist-release-structure.json",
  "name": "ArtistRelease",
  "description": "ArtistRelease schema from Discogs API",
  "type": "object",
  "properties": {
    "id": {
      "type": "int32"
    },
    "resource_url": {
      "type": "uri"
    },
    "type": {
      "type": "string",
      "enum": [
        "release",
        "master"
      ]
    },
    "title": {
      "type": "string"
    },
    "thumb": {
      "type": "uri"
    },
    "artist": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "year": {
      "type": "int32",
      "nullable": true
    },
    "format": {
      "type": "string",
      "nullable": true
    },
    "label": {
      "type": "string",
      "nullable": true
    },
    "status": {
      "type": "string",
      "nullable": true
    }
  }
}