            "name": "Discogs Get Release Community Rating",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.discogs.com/releases/:release_id/rating",
            "params": [
              {
                "name": "release_id",
                "value": "249504",
                "type": "path",
                "description": "Release ID."
              }
            ]
          },
          "docs": "Return the aggregate community rating for a release."
