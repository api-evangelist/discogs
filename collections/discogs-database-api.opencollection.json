            "name": "Discogs Get an Artist",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.discogs.com/artists/:artist_id",
            "params": [
              {
                "name": "artist_id",
                "value": "108713",
                "type": "path",
                "description": "The ID of the artist."
              }
            ]
          },
          "docs": "Retrieves details for a specific artist."
        },
